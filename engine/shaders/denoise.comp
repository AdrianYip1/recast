#version 460
#extension GL_GOOGLE_include_directive : require

#define CUSTOM_PUSH
#include "common.glsl"

// Spatial part of SVGF (Schied et al. 2017): edge-aware a-trous passes over the illumination (samples without their
// texture), guided by surface distance, normal and the per-pixel noise. The noise estimate is the variance of the
// accumulated mean, so the filter fades out on its own as samples add up. The texture is put back after the last pass

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform DenoisePush {
	uint pass;
	uint passCount;
	uint samples;
	uint pad;
} push;

layout(set = 1, binding = 1, rgba32f) uniform readonly image2D accumulation;
layout(set = 1, binding = 2, rgba16f) uniform writeonly image2D outputImage;
layout(set = 1, binding = 5, rgba32f) uniform readonly image2D illumination;
layout(set = 1, binding = 6, rgba32f) uniform readonly image2D guide;
layout(set = 1, binding = 7, rgba32f) uniform image2D ping;
layout(set = 1, binding = 8, rgba32f) uniform image2D pong;

float luminance(vec3 c) {
	return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

bool inView(ivec2 pixel) {
	vec2 uv = (vec2(pixel) + 0.5 - frame.viewport.xy) / frame.viewport.zw;
	return all(greaterThanEqual(uv, vec2(0.0))) && all(lessThanEqual(uv, vec2(1.0)));
}

// rgb = mean illumination, a = its variance
vec4 sourceAt(ivec2 pixel) {
	if (push.pass == 0u) {
		float n = float(max(push.samples, 1u));
		vec4 sum = imageLoad(illumination, pixel);
		vec3 mean = sum.rgb / n;
		float meanLuminance = luminance(mean);
		return vec4(mean, max(sum.a / n - meanLuminance * meanLuminance, 0.0) / n);
	}
	return push.pass % 2u == 1u ? imageLoad(ping, pixel) : imageLoad(pong, pixel);
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(pixel, imageSize(outputImage)))) return;
	bool last = push.pass + 1u == push.passCount;
	if (!inView(pixel)) {
		if (last) imageStore(outputImage, pixel, vec4(0.1, 0.1, 0.1, 0.0));
		return;
	}

	const float kernel[3] = float[](3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0);
	int step = 1 << push.pass;
	vec4 center = sourceAt(pixel);
	vec4 surface = imageLoad(guide, pixel);
	float centerLuminance = luminance(center.rgb);
	float luminanceScale = 4.0 * sqrt(center.a) + 1e-5;

	vec3 sum = vec3(0.0);
	float weightSum = 0.0, varianceSum = 0.0;
	for (int y = -2; y <= 2; y++) {
		for (int x = -2; x <= 2; x++) {
			ivec2 at = pixel + ivec2(x, y) * step;
			if (any(lessThan(at, ivec2(0))) || any(greaterThanEqual(at, imageSize(outputImage))) || !inView(at)) continue;

			vec4 value = (x == 0 && y == 0) ? center : sourceAt(at);
			float weight = kernel[abs(x)] * kernel[abs(y)];
			if (x != 0 || y != 0) {
				vec4 other = imageLoad(guide, at);
				if (sign(other.w) != sign(surface.w)) continue;
				weight *= exp(-abs(surface.w - other.w) / (0.02 * abs(surface.w) * float(step) + 1e-3));
				weight *= pow(max(dot(surface.xyz, other.xyz), 0.0), 64.0);
				weight *= exp(-abs(centerLuminance - luminance(value.rgb)) / luminanceScale);
			}
			sum += value.rgb * weight;
			varianceSum += value.a * weight * weight;
			weightSum += weight;
		}
	}
	vec4 filtered = vec4(sum / weightSum, varianceSum / (weightSum * weightSum));

	if (!last) {
		if (push.pass % 2u == 0u) imageStore(ping, pixel, filtered);
		else imageStore(pong, pixel, filtered);
		return;
	}

	// Put the texture back: per-pixel ratio of accumulated colour to accumulated illumination
	float n = float(max(push.samples, 1u));
	vec4 colorSum = imageLoad(accumulation, pixel);
	vec3 color = colorSum.rgb / n;
	vec3 light = imageLoad(illumination, pixel).rgb / n;
	vec3 result;
	for (int c = 0; c < 3; c++) result[c] = light[c] > 1e-4 ? color[c] / light[c] * filtered[c] : color[c];
	imageStore(outputImage, pixel, vec4(result, colorSum.a / n));
}
