#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_nonuniform_qualifier : require

#define CUSTOM_PUSH
#include "common.glsl"
#include "trace.glsl"

// Differential path tracing: static casters are the photo's surfaces, dynamic casters the inserted objects.
// Photo surfaces show photo * irradiance(with objects) / irradiance(without), so they stay exactly the photo
// wherever the objects change nothing. Ambient light arrives evenly from the room (irradiance frame.ambient on an
// open surface), matching how the lighting was fitted; only rays that hit an object see something else.

layout(local_size_x = 8, local_size_y = 8) in;

vec3 incomingRadiance(vec3 origin, vec3 direction, uint lightSeed) {
	Hit hit = traceClosest(origin, direction, MASK_ALL);
	if (!hit.found) return frame.ambient.rgb;
	return hit.dynamic ? objectDiffuse(hit, lightSeed) : roomRadiance(hit, lightSeed);
}

// One cosine-weighted sample of the ambient irradiance
vec3 ambientLight(vec3 position, vec3 normal, inout uint state, uint lightSeed) {
	Hit hit = traceClosest(position + normal * SURFACE_OFFSET, cosineSample(normal, state), MASK_ALL);
	if (!hit.found || !hit.dynamic) return frame.ambient.rgb;
	return objectDiffuse(hit, lightSeed);
}

// One GGX importance sample of the glossy reflection
vec3 reflection(vec3 position, vec3 normal, vec3 view, float alpha, vec3 f0, inout uint state, uint lightSeed) {
	float u = random(state);
	float phi = 2.0 * PI * random(state);
	float cosTheta = sqrt((1.0 - u) / (1.0 + (alpha * alpha - 1.0) * u));
	float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
	vec3 halfway = basis(normal) * vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
	vec3 direction = reflect(-view, halfway);

	float NdotL = dot(normal, direction);
	float NdotV = max(dot(normal, view), 1e-4);
	if (NdotL <= 0.0) return vec3(0.0);
	float VdotH = max(dot(view, halfway), 0.0);
	vec3 weight = fresnel(f0, VdotH) * smithG(NdotL, NdotV, alpha) * VdotH / (max(dot(normal, halfway), 1e-4) * NdotV);
	return weight * incomingRadiance(position + normal * SURFACE_OFFSET, direction, lightSeed);
}

// Light seen through glass: follows the ray through the objects until it reaches the room or an opaque object
vec3 throughGlass(Hit hit, vec3 direction, inout uint state, uint lightSeed) {
	vec3 throughput = vec3(1.0);
	for (int bounce = 0; bounce < 8; bounce++) {
		vec3 origin = glassBounce(hit, direction, throughput, state);
		hit = traceClosest(origin, direction, MASK_ALL);
		if (!hit.found) return throughput * frame.ambient.rgb;
		if (!hit.dynamic) return throughput * roomRadiance(hit, lightSeed);
		if (materials[hit.material].transmission <= 0.0) return throughput * objectDiffuse(hit, lightSeed);
	}
	return vec3(0.0);
}

vec3 shadeObject(Hit hit, vec3 view, inout uint state, uint lightSeed) {
	Material material = materials[hit.material];
	if (material.transmission > 0.0 && random(state) < material.transmission) {
		float roughness = clamp(material.roughness, 0.05, 1.0);
		float f0 = (1.0 - material.ior) / (1.0 + material.ior);
		vec3 irradiance, highlight;
		directLight(hit.position, hit.normal, view, MASK_ALL, lightSeed, roughness * roughness, vec3(f0 * f0), irradiance, highlight);
		return highlight + throughGlass(hit, -view, state, lightSeed);
	}

	vec3 albedo = albedoOf(hit);
	float metallic = clamp(material.metallic, 0.0, 1.0);
	float roughness = clamp(material.roughness, 0.05, 1.0);
	float alpha = roughness * roughness;
	vec3 f0 = mix(vec3(0.04 * clamp(material.specular, 0.0, 1.0)), albedo, metallic);

	vec3 irradiance, specular;
	directLight(hit.position, hit.normal, view, MASK_ALL, lightSeed, alpha, f0, irradiance, specular);
	vec3 diffuseColor = albedo * (1.0 - metallic) * (1.0 - fresnel(f0, max(dot(hit.normal, view), 0.0)));
	vec3 ambient = incomingRadiance(hit.position + hit.normal * SURFACE_OFFSET, cosineSample(hit.normal, state), lightSeed);
	vec3 diffuse = diffuseColor * (ambient + irradiance);
	return diffuse + specular + reflection(hit.position, hit.normal, view, alpha, f0, state, lightSeed) + material.emissive.rgb;
}

vec3 radiance(vec2 viewportUV, vec2 pixelUV, inout uint state, out float objectCoverage) {
	vec4 target = inverse(frame.proj * frame.view) * vec4(viewportUV * 2.0 - 1.0, 0.5, 1.0);
	vec3 origin = frame.cameraPos.xyz;
	vec3 direction = normalize(target.xyz / target.w - origin);
	uint lightSeed = hash(state ^ 0x9e3779b9u);

	vec3 photo = photoAt(pixelUV);
	Hit hit = traceClosest(origin, direction, MASK_ALL);
	objectCoverage = hit.found && hit.dynamic ? 1.0 : 0.0;
	if (!hit.found) return photo;
	if (hit.dynamic) return shadeObject(hit, -direction, state, lightSeed);

	vec3 withoutObjects = frame.ambient.rgb + directIrradiance(hit.position, hit.normal, MASK_STATIC, lightSeed);
	vec3 withObjects = ambientLight(hit.position, hit.normal, state, lightSeed) + directIrradiance(hit.position, hit.normal, MASK_ALL, lightSeed);
	return photo * withObjects / max(withoutObjects, vec3(1e-4));
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(pixel, imageSize(outputImage)))) return;

	vec2 pixelUV = (vec2(pixel) + 0.5 - frame.viewport.xy) / frame.viewport.zw;
	if (any(lessThan(pixelUV, vec2(0.0))) || any(greaterThan(pixelUV, vec2(1.0)))) {
		imageStore(outputImage, pixel, vec4(0.1, 0.1, 0.1, 0.0));
		return;
	}

	// rgb = summed radiance, a = summed object coverage (alpha of the output, used by the camera matching in tonemap)
	vec4 sum = push.sampleIndex == 0u ? vec4(0.0) : imageLoad(accumulation, pixel);
	if (push.trace != 0u) {
		uint state = hash(uint(pixel.x) ^ hash(uint(pixel.y) ^ hash(push.sampleIndex)));
		vec2 jitter = push.sampleIndex == 0u ? vec2(0.5) : vec2(random(state), random(state));
		vec2 viewportUV = (vec2(pixel) + jitter - frame.viewport.xy) / frame.viewport.zw;
		float coverage;
		vec3 color = radiance(viewportUV, pixelUV, state, coverage);
		sum += vec4(color, coverage);
		imageStore(accumulation, pixel, sum);
	}
	float samples = float(push.trace != 0u ? push.sampleIndex + 1u : push.sampleIndex);
	imageStore(outputImage, pixel, sum / max(samples, 1.0));
}
