#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_nonuniform_qualifier : require

#define CUSTOM_PUSH
#include "common.glsl"

// Differential path tracing: static casters are the photo's surfaces, dynamic casters the inserted objects.
// Photo surfaces show photo * irradiance(with objects) / irradiance(without), so they stay exactly the photo
// wherever the objects change nothing. Ambient light arrives evenly from the room (irradiance frame.ambient on an
// open surface), matching how the lighting was fitted; only rays that hit an object see something else.

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform TracePush {
	uint sampleIndex;
	uint photoTexture;
	uint trace;
	uint pad;
} push;

layout(set = 1, binding = 0) uniform accelerationStructureEXT scene;
layout(set = 1, binding = 1, rgba32f) uniform image2D accumulation;
layout(set = 1, binding = 2, rgba16f) uniform writeonly image2D outputImage;

struct Geometry {
	uvec2 vertexAddress;
	uvec2 indexAddress;
	uint firstIndex;
	uint materialIndex;
	uint dynamic;
	uint pad;
};

layout(std430, set = 1, binding = 3) readonly buffer Geometries {
	Geometry geometries[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Floats { float f[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Indices { uint i[]; };

const uint MASK_STATIC = 0x01u;
const uint MASK_ALL = 0xFFu;
const uint VERTEX_FLOATS = 8u;
const float PI = 3.14159265;
const float SURFACE_OFFSET = 1e-3;

struct Hit {
	bool found;
	bool dynamic;
	vec3 position;
	vec3 normal;
	vec2 uv;
	uint material;
};

uint hash(uint x) {
	x ^= x >> 16;
	x *= 0x7feb352du;
	x ^= x >> 15;
	x *= 0x846ca68bu;
	x ^= x >> 16;
	return x;
}

float random(inout uint state) {
	state = hash(state);
	return float(state >> 8) / 16777216.0;
}

vec3 cosineSample(vec3 normal, inout uint state) {
	float u = random(state);
	float phi = 2.0 * PI * random(state);
	vec3 tangent = normalize(cross(normal, abs(normal.x) > 0.5 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0)));
	vec3 bitangent = cross(normal, tangent);
	float r = sqrt(u);
	return normalize(tangent * (r * cos(phi)) + bitangent * (r * sin(phi)) + normal * sqrt(max(0.0, 1.0 - u)));
}

Hit traceClosest(vec3 origin, vec3 direction, uint mask) {
	rayQueryEXT query;
	rayQueryInitializeEXT(query, scene, gl_RayFlagsOpaqueEXT, mask, origin, 1e-4, direction, 1e30);
	while (rayQueryProceedEXT(query)) {}

	Hit hit;
	hit.found = rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
	if (!hit.found) return hit;

	Geometry geometry = geometries[rayQueryGetIntersectionInstanceCustomIndexEXT(query, true) + rayQueryGetIntersectionGeometryIndexEXT(query, true)];
	Indices indices = Indices(geometry.indexAddress);
	Floats vertices = Floats(geometry.vertexAddress);
	uint first = geometry.firstIndex + 3u * uint(rayQueryGetIntersectionPrimitiveIndexEXT(query, true));

	vec2 barycentrics = rayQueryGetIntersectionBarycentricsEXT(query, true);
	vec3 weights = vec3(1.0 - barycentrics.x - barycentrics.y, barycentrics.x, barycentrics.y);
	vec3 normal = vec3(0.0);
	vec2 uv = vec2(0.0);
	for (uint k = 0u; k < 3u; k++) {
		uint v = indices.i[first + k] * VERTEX_FLOATS;
		normal += weights[k] * vec3(vertices.f[v + 3u], vertices.f[v + 4u], vertices.f[v + 5u]);
		uv += weights[k] * vec2(vertices.f[v + 6u], vertices.f[v + 7u]);
	}

	normal = normalize(mat3(rayQueryGetIntersectionObjectToWorldEXT(query, true)) * normal);
	if (dot(normal, direction) > 0.0) normal = -normal;

	hit.dynamic = geometry.dynamic != 0u;
	hit.position = origin + direction * rayQueryGetIntersectionTEXT(query, true);
	hit.normal = normal;
	hit.uv = uv;
	hit.material = geometry.materialIndex;
	return hit;
}

bool occluded(vec3 origin, vec3 direction, float maxDistance, uint mask) {
	rayQueryEXT query;
	rayQueryInitializeEXT(query, scene, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, mask, origin, 1e-4, direction, maxDistance);
	while (rayQueryProceedEXT(query)) {}
	return rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

vec3 directLight(vec3 position, vec3 normal, uint mask) {
	uint count = frame.lightInfo.x;
	if (count == 0u) return vec3(0.65 * abs(dot(normal, -frame.lightDir.xyz)));

	vec3 origin = position + normal * SURFACE_OFFSET;
	vec3 result = vec3(0.0);
	for (uint i = 0u; i < count; i++) {
		Light light = frame.lights[i];
		bool directional = light.intensity.w > 0.5;
		vec3 toLight = directional ? -light.direction.xyz : light.position.xyz - position;
		float distance = directional ? 1e30 : length(toLight);
		vec3 direction = normalize(toLight);
		float cosine = dot(normal, direction);
		if (cosine <= 0.0) continue;
		if (light.position.w > 0.5 && occluded(origin, direction, distance, mask)) continue;
		result += light.intensity.rgb * cosine / (directional ? 1.0 : max(distance * distance, 1e-4));
	}
	return result;
}

vec3 albedoOf(Hit hit) {
	Material material = materials[hit.material];
	return material.baseColor.rgb * textureLod(textures[nonuniformEXT(material.baseColorTexture)], hit.uv, 0.0).rgb;
}

// One cosine-weighted sample of the ambient irradiance
vec3 ambientLight(vec3 position, vec3 normal, inout uint state) {
	Hit hit = traceClosest(position + normal * SURFACE_OFFSET, cosineSample(normal, state), MASK_ALL);
	if (!hit.found || !hit.dynamic) return frame.ambient.rgb;
	return albedoOf(hit) * (frame.ambient.rgb + directLight(hit.position, hit.normal, MASK_ALL));
}

vec3 radiance(vec2 viewportUV, vec2 pixelUV, inout uint state) {
	vec4 target = inverse(frame.proj * frame.view) * vec4(viewportUV * 2.0 - 1.0, 0.5, 1.0);
	vec3 origin = frame.cameraPos.xyz;
	vec3 direction = normalize(target.xyz / target.w - origin);

	vec3 photo = textureLod(textures[push.photoTexture], pixelUV, 0.0).rgb;
	Hit hit = traceClosest(origin, direction, MASK_ALL);
	if (!hit.found) return photo;

	if (hit.dynamic) {
		vec3 irradiance = ambientLight(hit.position, hit.normal, state) + directLight(hit.position, hit.normal, MASK_ALL);
		return albedoOf(hit) * irradiance + materials[hit.material].emissive.rgb;
	}

	vec3 withoutObjects = frame.ambient.rgb + directLight(hit.position, hit.normal, MASK_STATIC);
	vec3 withObjects = ambientLight(hit.position, hit.normal, state) + directLight(hit.position, hit.normal, MASK_ALL);
	return photo * withObjects / max(withoutObjects, vec3(1e-4));
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(pixel, imageSize(outputImage)))) return;

	vec2 pixelUV = (vec2(pixel) + 0.5 - frame.viewport.xy) / frame.viewport.zw;
	if (any(lessThan(pixelUV, vec2(0.0))) || any(greaterThan(pixelUV, vec2(1.0)))) {
		imageStore(outputImage, pixel, vec4(0.1, 0.1, 0.1, 1.0));
		return;
	}

	vec4 sum = push.sampleIndex == 0u ? vec4(0.0) : imageLoad(accumulation, pixel);
	if (push.trace != 0u) {
		uint state = hash(uint(pixel.x) ^ hash(uint(pixel.y) ^ hash(push.sampleIndex)));
		vec2 jitter = push.sampleIndex == 0u ? vec2(0.5) : vec2(random(state), random(state));
		vec2 viewportUV = (vec2(pixel) + jitter - frame.viewport.xy) / frame.viewport.zw;
		sum += vec4(radiance(viewportUV, pixelUV, state), 1.0);
		imageStore(accumulation, pixel, sum);
	}
	imageStore(outputImage, pixel, vec4(sum.rgb / max(sum.a, 1.0), 1.0));
}
